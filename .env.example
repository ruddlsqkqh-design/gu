# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=asia-northeast3
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# Document AI
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
DOCUMENT_AI_PROCESSOR_LOCATION=us

# Vertex AI
VERTEX_AI_EMBEDDING_MODEL=text-multilingual-embedding-002
VERTEX_AI_LLM_MODEL=gemini-1.5-pro-002

# ChromaDB
CHROMA_DB_PATH=./storage/chroma_db

# Storage
STORAGE_BASE_PATH=./storage
ORIGINALS_PATH=./storage/originals
OCR_RESULTS_PATH=./storage/ocr_results

# App Settings
MAX_FILE_SIZE_MB=50
MAX_PAGES=200
CHUNK_MIN_TOKENS=500
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP_TOKENS=100
TOP_K_CANDIDATES=10
TOP_N_RETRIEVAL=50
